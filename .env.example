PORT=3000

# Solo si el proxy corporativo (zScaler) rompe los certificados
ALLOW_INSECURE_TLS=false

# Dominios autorizados (separados por coma). Solo se escanean estos y sus subdominios.
ALLOWED_DOMAINS=azmed.cr,azmed.com.mx,azmed.com.br,azmed.com.ar,azmed.cl,azmed.uy

# Host de PromoMats (sin https://)
VAULT_HOST=astrazeneca-promomats.veevavault.com
# URL base para abrir fichas de documento. {ID} se reemplaza por el Approval ID
VAULT_SEARCH_URL=https://astrazeneca-promomats.veevavault.com/ui/#search/{ID}

# Kaltura
KALTURA_PARTNER_ID=
KALTURA_SERVICE_URL=https://www.kaltura.com

# Limites
MAX_PAGES=800
# Cola de áreas: segundos de pausa entre áreas (se duplica si una área sufre bloqueos del WAF)
QUEUE_PAUSE_SECONDS=45
MAX_DEPTH=6
PAGE_TIMEOUT_MS=25000
MAX_OCR_IMAGES_PER_PAGE=15
WARNING_DAYS=60
VAULT_CONCURRENCY=3

# OCR de imagenes (requiere ocr-data/eng.traineddata.gz, ver README)
OCR_ENABLED=true

# Pestañas de rastreo en paralelo (1-6). Si aparecen bloqueos del WAF, bajar a 2.
CRAWL_CONCURRENCY=3
# Reintentos por pagina ante timeout o bloqueo temporal
PAGE_RETRIES=1
# (Opcional) URL protegida de AzMed para validar la sesion. Si se deja vacia, se aprende sola
# la primera vez que un escaneo encuentra una pagina que pide login.
AZMED_PROBE_URL=

# Carpeta donde se guardan sesiones (.sessions), historial y capturas (data).
# Por defecto: la del proyecto; si el proyecto está en OneDrive, %LOCALAPPDATA%\AZ-Content-Scanner
# para que las cookies de sesión no se sincronicen a la nube.
# DATA_DIR=C:\AZ-Content-Scanner-data

# Fecha ambigua de PromoMats (03/04/2026): dmy (día/mes, por defecto) o mdy (mes/día)
# VAULT_DATE_FORMAT=dmy
# Workers de OCR en paralelo (1-4, ~100 MB cada uno)
# OCR_WORKERS=2
# Diagnósticos (/api/vault/inspect/:id y /api/capture-test): desactivados por defecto
# ENABLE_DIAGNOSTICS=false
# Hosts extra aceptados en la cabecera Host (solo si publicas el servidor con HOST o un proxy)
# ALLOWED_HOSTS=
